{
	"name": "admin-lte-svelte",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"pretty": "pnpm dlx prettier --write \"src/**/*.ts\" \"src/**/*.svelte\""
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/bootstrap": "^5.2.11",
		"@types/sortablejs": "^1.15.9",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource/source-sans-3": "^5.3.1",
		"apexcharts": "^8.5.0",
		"bootstrap": "^5.3.8",
		"bootstrap-icons": "1.13.1",
		"flatpickr": "4.6.13",
		"jsvectormap": "^1.7.0",
		"overlayscrollbars": "^2.17.0",
		"quill": "2.0.3",
		"sortablejs": "^1.15.7",
		"tom-select": "2.6.2"
	}
}
